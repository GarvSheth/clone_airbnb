<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kiwi</title>
</head>
<body>
    <h1>List of Places</h1>
    <ul>
        <% for(let i = 0; i < places.length; i++) { %>
            <li>
                <strong>Name:</strong><a href="/listings/<%=places[i]._id%>"> <%= places[i].title %></a><br>
                <strong>Description:</strong> <%= places[i].description %><br>
                <strong>Location:</strong> <%= places[i].location %><br>
                <strong>Country:</strong> <%= places[i].country %><br>
                <strong>Price:</strong> $<%= places[i].price %>
            </li>
            <hr>
        <% } %>
    </ul>
    <form method="get" action="/listnigs/new">
        <button>Add new place</button>
    </form>
</body>
</html>