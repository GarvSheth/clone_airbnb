<% layout("/layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <h1>Edit this listing</h1>
            <form novalidate class="needs-validation" method="POST" action="/listings/<%= edit_place._id %>?_method=PUT">
                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input type="text" id="title" name="listing[title]" class="form-control" value="<%= edit_place.title %>" required>
                    <div class="invalid-feedback">Title is invalid</div>
                </div>
                <div class="mb-3">
                    <label for="exampleFormControlTextarea1" class="form-label">Description</label>
                    <textarea id="description" name="listing[description]" name="description" class="form-control" id="exampleFormControlTextarea1" rows="3" required><%= edit_place.description %></textarea>
                    <div class="invalid-feedback">Description is invalid</div>   
                </div>    
                <div class="mb-3">
                    <label for="exampleInputImage1" class="form-label">Image Link</label>
                    <input id="image" name="listing[image]" class="form-control" value="<%= edit_place.image %>" >
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="exampleInputPrize1" class="form-label">Prize</label>
                        <input type="number" id="price" name="listing[price]" class="form-control" value="<%= edit_place.price %>" required>
                        <div class="invalid-feedback">Prize is invalid</div>
                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="exampleInputLocation1" class="form-label">Location</label>
                        <input type="text" id="location" name="listing[location]" class="form-control" value="<%= edit_place.location %>" required>
                        <div class="invalid-feedback">Location doesn't exist</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="exampleInputCountry1" class="form-label">Country</label>
                    <input type="text" id="country" name="listing[country]" class="form-control" value="<%= edit_place.country %>" required>
                    <div class="invalid-feedback">Country Name is invalid</div>
                </div>
                <button type="Edit" class="btn btn-primary edit-btn">Edit</button><br /> 
            </form>
        </div>
    </div>
</body>
