<% layout("/layouts/boilerplate") %>
<body>
    <h1 class="title mt-2">All Listings</h1>
    <div class="row row-cols-lg-3 row-cols-md-2 row-col-sm-1">
        <% for(let i = 0; i < places.length; i++) { %>
            <a href="/listings/<%= places[i]._id %>" class="listing-link">
                <div class="card col listing-card">
                    <img class="card-img-top" src="https://img.freepik.com/free-photo/big-ben-westminster-bridge-sunset-london-uk_268835-1395.jpg?t=st=1735823200~exp=1735826800~hmac=44ae6ad2a3b9283a5aced4d52eea9b5077adee037568a66087bb10bdca3a81b6&w=900" alt="Listing_image" style="height: 20rem;">
                    <div class="card-body">
                      <p class="card-title mb-0"> <b><%= places[i].title %></b></p>
                      <p class="mb-0">5 nights - 10-14 Jan</p>
                      <p class="card-text mb-0">$<%= places[i].price%>/night, before tax</p>
                      <!-- <a href="/listings/<%= places[i]._id%>" class="btn btn-primary">Details</a> -->
                    </div>
                </div>
            </a>
        <% } %>
    </div>
    <!-- <form method="get" action="/listings/new">
        <button>Add new place</button>
    </form> -->
</body>