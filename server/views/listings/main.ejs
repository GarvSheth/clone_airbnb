<% layout("/layouts/boilerplate") %>
<style>
    #filters{
        display: flex;
        flex-wrap: wrap;
    }

    .filter{
        text-align: center;
        margin-right: 2rem;
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
        opacity: 0.7;
    }

    .filter:hover{
        opacity: 1;
        cursor: pointer;
    }

    .filter p{
        font-size: 0.8rem;
    }
</style>
<body>
    <!-- <h1 class="title mt-2">All Listings</h1> -->
    <div class="main">
        <div id="filters">
            <div class="filter">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-bed"></i></div>
                <p>Rooms</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-person-swimming"></i></div>
                <p>Amazing pools</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-mountain-sun"></i></i></div>
                <p>Mountains</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-city"></i></div>
                <p>Iconic cities</p>
            </div>
            <div class="filter">
                <div><i class="fa-brands fa-fort-awesome"></i></div>
                <p>Castles</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-campground"></i></div>
                <p>Amazing views</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-cow"></i></div>
                <p>Farms</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-umbrella-beach"></i></div>
                <p>Beachfront</p>
            </div>
            <div class="filter">
                <div><i class="fa-regular fa-snowflake"></i></div>
                <p>Arctic</p>
            </div><div class="filter">
                <div><i class="fas fa-water"></i></div>
                <p>Islands</p>
            </div>

            <div class="tax-toggler">
                <div class="form-check-reverse form-switch">
                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
                    <label class="form-check-label" for="flexSwitchCheckDefault">Display after total taxes</label>
                </div>
            </div>
        </div>

        <div class="row row-cols-lg-3 row-cols-md-2 row-col-sm-1">
            <% for(let i = 0; i < places.length; i++) { %>
                <a href="/listings/<%= places[i]._id %>" class="listing-link">
                    <div class="card col listing-card">
                        <img class="card-img-top" src="<%=places[i].image.url%>" alt="Listing_image" style="height: 20rem;" onerror=this.onerror=null; this.src="https://images.pexels.com/photos/208745/pexels-photo-208745.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1"; >
                        <div class="card-body">
                        <p class="card-title mb-0"> <b><%= places[i].title %></b></p>
                        <p class="mb-0">5 nights - 10-14 Jan</p>
                        <p class="card-text mb-0" id="before-tax">$<%= places[i].price%>/night, before tax</p>
                        <p class="card-text mb-0" id="after-tax">$<%= places[i].price *5 *1.18%> total after taxes</p>
                        </div>
                    </div>
                </a>
            <% } %>
        </div>
    </div>
</body>

<script>
    let taxSwitch=document.getElementById("flexSwitchCheckDefault");
    taxSwitch.addEventListener("click", ()=>{

    });
</script>