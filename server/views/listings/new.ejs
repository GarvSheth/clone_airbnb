<% layout("/layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <br /> 
            <h1>Add a New Place</h1>
            <form novalidate class="needs-validation" method="POST" action="/listings" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input placeholder="Enter Title" type="text" name="listing[title]" class="form-control" id="exampleInputTitle1" required>
                    <div class="invalid-feedback">Title is invalid</div>
                </div>
                <div class="mb-3">
                    <label for="exampleFormControlTextarea1" class="form-label">Description</label>
                    <textarea placeholder="Enter Description" name="listing[description]" class="form-control" id="exampleFormControlTextarea1" rows="3" required></textarea>
                    <div class="invalid-feedback">Description is invalid</div>
                </div>    
                <div class="mb-3">
                    <label for="exampleInputImage1" class="form-label">Upload Listing Image</label>
                    <input type="file" class="form-control" name="listing[image]" id="exampleInputImage1" >
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="exampleInputPrize1" class="form-label">Prize</label>
                        <input placeholder="Enter Price" type="number" name="listing[price]" class="form-control" id="exampleInputPrize1" required>
                        <div class="invalid-feedback">Prize is invalid</div>
                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="exampleInputLocation1" class="form-label">Location</label>
                        <input placeholder="Enter City" type="text" name="listing[location]" class="form-control" id="exampleInputLocation1" required>
                        <div class="invalid-feedback">Location not exist</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="exampleInputCountry1" class="form-label">Country</label>
                    <input placeholder="Enter Country" type="text" name="listing[country]" class="form-control" id="exampleInputCountry1" required>
                    <div class="invalid-feedback">Country Name is invalid</div>
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="exampleCheck1">
                    <label class="form-check-label" for="exampleCheck1">Add Listing</label>
                </div>
                <button type="submit" class="btn btn-primary add-btn">Submit</button><br />
            </form> 
        </div>
    </div>
</body>
