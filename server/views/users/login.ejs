<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <h2 class="col-6 offset-3 mt-5">Login</h2>
    <div class="col-6 offset-3 mt-3">
        <form action="/login" method="post" class="needs-validation" novalidate>
            <div class="mb-4">
                <label class="form-label">Username</label>
                <input type="text" for="username" name="username" id="username" placeholder="Enter Username" class="form-control" id="exampleInputImage1" required>
                <div class="invalid-feedback">Required</div>
            </div>
            <div class="mb-4">
                <label class="form-label">Password</label>
                <input type="password" for="password" name="password" id="password" class="form-control" id="exampleInputImage1" required>
                <div class="invalid-feedback">Required</div>
            </div>
            <button type="submit" class="btn btn-success">Login</button>
        </form>
    </div>
</div>